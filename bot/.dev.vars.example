# Example local environment variables for Cloudflare Wrangler
# Copy this file to .dev.vars and insert your secrets.

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# NVIDIA NIM API key for natural language fallback parsing
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Gemini API key fallback (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard URL for Telegram Mini App button (optional)
DASHBOARD_URL=http://localhost:3002
