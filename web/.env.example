# Cloudflare D1 local and production configuration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Next.js Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orbit Fund Management"

# Admin panel secret passkey (protects /admin)
ADMIN_SECRET_KEY="your_secure_admin_passkey_here"

# Bot API synchronization key (shared secret between Telegram Bot and Web API)
BOT_API_KEY="your_secure_bot_api_key_here"

# Authentication (optional Clerk integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
