# Cloudflare D1 Ledger Configuration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Next.js Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orbit Fund Management"

# Admin panel secret passkey (protects /admin)
ADMIN_SECRET_KEY="your_admin_secret_key"

# Bot API synchronization key (shared secret between Telegram Bot and Web API)
BOT_API_KEY="your_bot_api_key"

# Telegram Bot Token from @BotFather
BOT_TOKEN=""

# AI Fallback Parser (NVIDIA NIM)
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# Web API and Dashboard endpoints
WEB_API_URL="http://localhost:3000"
DASHBOARD_URL="http://localhost:3000"
